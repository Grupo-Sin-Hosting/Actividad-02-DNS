// /etc/bind/named.conf.options — ns2: servidor AUTORITATIVO (secundario) (no resuelve nombres ajenos)
options {
    directory "/var/cache/bind";

    listen-on    { any; };
    listen-on-v6 { none; };

    recursion no;                 // un autoritativo no hace de resolutor: evita ataques de amplificación
    allow-query     { any; };     // cualquiera puede preguntar por NUESTRAS zonas
    allow-transfer  { none; };    // por defecto nadie copia zonas (se abre por zona y con clave)

    version "no disponible";      // no revelar la versión de BIND (dig CH TXT version.bind)
    dnssec-validation auto;
    minimal-responses yes;
};
