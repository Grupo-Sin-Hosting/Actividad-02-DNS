// /etc/bind/named.conf.local — ns2 (SECUNDARIO) de horizonte.internal: copia las zonas de ns1
include "/etc/bind/transferencia.key";

// Toda conversación con ns1 (pedir la zona) se firma con la clave TSIG
// TODO: bloque server 10.10.10.2 { keys { … }; }; para firmar con TSIG lo que se pide a ns1
server 10.10.10.2 { keys { "transferencia-horizonte"; }; };
zone "horizonte.internal" {
    type secondary;
    primaries { 10.10.10.2; };
    file "/var/lib/bind/db.horizonte.internal.sec";   // copia local (sobrevive a un reinicio de ns2)
    allow-transfer { none; };
};

// TODO: la zona inversa 10.10.10.in-addr.arpa como secundaria (igual que la directa)
zone "10.10.10.in-addr.arpa" {
    type secondary;
    primaries { 10.10.10.2; };
    file "/var/lib/bind/db.10.10.10.sec";
    allow-transfer { none; };
};